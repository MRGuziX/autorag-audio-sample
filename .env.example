# Fill this file, save it as .env, then run:
# uv run python scripts/run_experiment.py
# Variable names match autox-ci/autox_tests/.env.rag where applicable.

# Existing RHOAI project and pipeline API route.
RHOAI_PROJECT_NAME=
RHOAI_KFP_URL=
# Optional: leave blank to reuse oc login; otherwise supply a current bearer token.
RHOAI_TOKEN=

# Optional compiled local pipeline YAMLs. Blank/unset uses the installed managed pipeline.
# A filled path takes precedence over managed pipeline/version IDs.
AUTORAG_PIPELINE_PATH=
AUTORAG_INDEXING_PIPELINE_PATH=

# Existing project Connection secret names (not their passwords/API keys).
INPUT_DATA_SECRET_NAME=
INPUT_DATA_BUCKET_NAME=
MAAS_SECRET_NAME=
VECTOR_DB_SECRET_NAME=
# Blank means use the input Connection/bucket above.
TEST_DATA_SECRET_NAME=
TEST_DATA_BUCKET_NAME=

# MaaS model IDs: JSON arrays or comma-separated lists, as in AutoX CI.
AUTORAG_EMBEDDING_MODELS=
AUTORAG_GENERATION_MODELS=

# Audio scenario TC-P-5: use objects already in S3; nothing is uploaded/deleted.
AUTORAG_INPUT_DATA_KEYS=["datasets/rag/audio/documents"]
AUTORAG_TEST_DATA_KEY=datasets/rag/audio/benchmark_data.json
AUTORAG_OPTIMIZATION_METRIC=answer_correctness
AUTORAG_MAX_RAG_PATTERNS=4
AUTORAG_PRESET=speed
AUTORAG_EXPERIMENT_NAME=autorag-audio-sample
RHOAI_PIPELINE_RUN_TIMEOUT=7200

# Optional: normally each invocation generates a unique run name.
# A fixed name blocks accidental resubmission while its local record exists.
# AUTORAG_RUN_NAME=audio-opt-001
# KFP_CA_CERT=/path/to/ca.pem
# RHOAI_DSPA_NAME=dspa
# AUTORAG_OC_CONTEXT=your-oc-context

# Optional local corpus upload. Set true, clear BOTH S3 path variables above,
# and select a fresh prefix. Requires workstation S3 credentials or an AWS profile.
AUTORAG_UPLOAD_TEST_DATASETS=false
# AUTORAG_DATASET_DIR=data
# AUTORAG_PROFILE=original-three
# AUTORAG_S3_PREFIX=autorag-audio/my-corpus-v1
# AWS_S3_ENDPOINT=https://your-s3-endpoint
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# After optimization, download the selected product pattern.json, then run:
# uv run python scripts/run_experiment.py --kind indexing
# AUTORAG_PATTERN_FILE=work/pattern.json
# AUTORAG_COLLECTION_NAME=audio_sample_001
