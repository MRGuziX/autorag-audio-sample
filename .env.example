# Copy to .env, fill the settings below, then run:
# uv run python scripts/run_experiment.py
# .env is ignored by Git. Do not source it.

# 1. OpenShift project and authentication
RHOAI_PROJECT_NAME=
# Pipeline API URL; blank discovers it through your current oc login.
RHOAI_KFP_URL=
# Leave blank to reuse oc login, or supply a current bearer token with RHOAI_KFP_URL.
RHOAI_TOKEN=

# 2. Existing project Connections and bucket
# Secret names only; do not paste Connection passwords or API keys here.
INPUT_DATA_SECRET_NAME=
INPUT_DATA_BUCKET_NAME=
MAAS_SECRET_NAME=
VECTOR_DB_SECRET_NAME=
# Blank inherits the input Connection/bucket. Local uploads require the same values.
TEST_DATA_SECRET_NAME=
TEST_DATA_BUCKET_NAME=

# 3. Models
# MaaS model IDs as JSON arrays or comma-separated lists.
AUTORAG_EMBEDDING_MODELS=
AUTORAG_GENERATION_MODELS=

# 4. Dataset paths (S3 keys inside the buckets above)
# Change BOTH paths to switch datasets. The pipeline reads these paths;
# when uploads are enabled, local files are uploaded to these same paths.
AUTORAG_INPUT_DATA_KEYS=["data/rag/audio/sample/documents"]
AUTORAG_TEST_DATA_KEY=data/rag/audio/sample/benchmark.json
# Own dataset example:
# AUTORAG_INPUT_DATA_KEYS=["data/rag/audio/users/documents"]
# AUTORAG_TEST_DATA_KEY=data/rag/audio/users/benchmark.json

# These are also the local paths when uploading: put recordings in the documents
# directory and the benchmark at the JSON path above. No separate upload paths.
# true uploads before running; false uses existing objects in S3.
AUTORAG_UPLOAD_TEST_DATASETS=true
# Changed recordings require fresh paths; different existing objects are not overwritten.

# 5. Workstation S3 access for dataset uploads and artifact downloads
# Download the completed run's artifacts to work/runs/<run-name>/artifacts/.
DOWNLOAD_ARTIFACTS=true
# Optional: blank uses the run's artifact root, then INPUT_DATA_BUCKET_NAME if unavailable.
# Also accepts the AutoX CI variable RHOAI_TEST_ARTIFACTS_BUCKET.
AWS_S3_BUCKET=
# Must reach the same storage as the input Connection. AWS credential chain is also supported.
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# 6. Experiment parameters
AUTORAG_EXPERIMENT_NAME=autorag-audio-sample
AUTORAG_OPTIMIZATION_METRIC=answer_correctness
AUTORAG_MAX_RAG_PATTERNS=4
AUTORAG_PRESET=speed
RHOAI_PIPELINE_RUN_TIMEOUT=7200
# Optional fixed name; an existing local record blocks resubmission under that name.
# AUTORAG_RUN_NAME=audio-opt-001

# 7. Pipeline source (optional)
# Blank uses the installed managed pipeline. A compiled local YAML path takes precedence.
AUTORAG_PIPELINE_PATH=
AUTORAG_INDEXING_PIPELINE_PATH=
# KFP_CA_CERT=/path/to/ca.pem
# RHOAI_DSPA_NAME=dspa
# AUTORAG_OC_CONTEXT=your-oc-context

# 8. Indexing after optimization (optional)
# Download the selected product pattern.json, fill these, then run:
# uv run python scripts/run_experiment.py --kind indexing
# AUTORAG_PATTERN_FILE=work/pattern.json
# AUTORAG_COLLECTION_NAME=audio_sample_001
